# JARVIS environment template.
# Copy to `.env` (chmod 600) and fill in real values. NEVER commit `.env`.

# --- GitHub (account: KenzBilal) ---
GITHUB_TOKEN=

# --- Supabase (Management API) ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_JARVIS_PROJECT_REF=
SUPABASE_JARVIS_URL=
SUPABASE_JARVIS_DB_PASSWORD=

# Session pooler (primary) / transaction pooler (high concurrency).
# Direct `db.*:5432` is unusable on this machine (no IPv6).
SUPABASE_DB_URL=
SUPABASE_DB_URL_TRANSACTION=

# --- Binance (Phase 2+: READ-ONLY keys, never withdrawal permission) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Telegram (Phase 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVED_USER_ID=

# --- AI provider (Phase 2; one of the adapter keys) ---
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# --- Redis (Phase 0; local container needs no auth) ---
REDIS_URL=redis://localhost:6379/0

# --- Runtime mode ---
JARVIS_ENV=development
TRADING_MODE=paper
LOG_LEVEL=INFO

# --- Browser API access (Next.js → FastAPI) ---
# Comma-separated origins allowed to call the API directly from the browser
# (the dashboard polls /health client-side). Default covers the local dev
# server; the production frontend origin is listed too. No wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://jarvisforme.vercel.app
